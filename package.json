{
  "name": "dsh-reunion-import",
  "version": "0.1.3",
  "description": "After install: paste a DeepSeek share link or ZIP and reunion_continue (import+load, ~3.5k-char brief). Plus portable persona/memory. Not a full-bubble session importer.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "chat-export",
    "persona",
    "memory",
    "companion",
    "重逢",
    "伴侣对话导入"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-0 <0.3.0-0"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-reunion": "./bin/reunion.mjs"
  },
  "files": [
    "index.js",
    "lib",
    "bin",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "examples"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check bin/reunion.mjs"
  }
}
